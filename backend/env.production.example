# EZ Accounts Production Environment Template
# Use this for Docker or Production distributions.
# Copy to .env and fill in the values.

# Database
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_NAME=EZAccountsProd

# Security (CRITICAL)
# Generate a long random string: openssl rand -hex 32
JWT_SECRET=
# Master key for backup encryption
MASTER_ENCRYPTION_KEY=

# Domains & Auth
# The Domain (RP ID) must match your HTTPS domain exactly for Passkeys (WebAuthn)
WEBAUTHN_RP_ID=ezaccounts.zerp.me
WEBAUTHN_RP_NAME="EZ Accounts"

# CORS (Comma-separated list of allowed origins)
CORS_ORIGINS=https://ezaccounts.zerp.me

# Azure OpenAI (Optional - for AI Invoice Parsing)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
DEPLOYMENT_NAME_GPT52=gpt-5.2

# Email Settings (Optional)
# SMTP_SERVER=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
