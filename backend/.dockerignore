# Scratch scripts and scratch data must never reach a production image.
# `ref/` held vendor demo files with a hardcoded API key, and test_db.py
# held a production Mongo URI — both shipped inside the image because
# the Dockerfile does `COPY . .` and nothing here excluded them.
