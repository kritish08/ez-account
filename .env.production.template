# ============================================================
# EZ Account — Production Environment Template
# Copy this file to backend/.env and fill in your values
# ============================================================

# ── Domain ──────────────────────────────────────────────────
# Frontend: https://ezaccounts.zerp.me
# Backend:  https://api-ezaccounts.zerp.me
# (hardcoded in docker-compose.yaml — no DOMAIN_NAME var needed)

# ── MongoDB Atlas ────────────────────────────────────────────
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_NAME=BlitzerDB

# ── App Security ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX
# Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX

# REQUIRED — the app refuses to start without it. Comma-separated list of
# exact origins allowed to call the API. "*" is rejected: browsers reject a
# wildcard on credentialed requests anyway.
CORS_ORIGINS=https://ezaccounts.zerp.me

# ── WebAuthn / Passkeys ──────────────────────────────────────
# REQUIRED in production. Must equal the host the BROWSER sees in the
# address bar (the frontend domain) — NOT the API host. If unset it
# defaults to "localhost" and the browser rejects passkeys with
# "The relying party ID is not a registrable domain suffix of ...".
# Frontend is https://ezaccounts.zerp.me, so:
WEBAUTHN_RP_ID=ezaccounts.zerp.me
WEBAUTHN_RP_NAME=EZ Accounts

# ── OpenAI (bill scanning + voice assistant) ─────────────────
# Native OpenAI, not Azure. Create a key at platform.openai.com.
# Both AI features are optional: leave OPENAI_API_KEY blank and the app
# still boots — bill scanning returns a clear error and the voice
# endpoints return 503.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Chat / function-calling model for the voice assistant.
OPENAI_MODEL=gpt-5.6
# Vision model that reads photographed bills. Defaults to OPENAI_MODEL.
OPENAI_VISION_MODEL=gpt-5.6
# Speech-to-text. gpt-4o-transcribe handles Hinglish better than whisper-1.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Optional ISO-639-1 hint for transcription, e.g. "hi" or "en". Naming the
# dominant language cuts spurious transliteration on code-switched speech.
# Leave blank to let the model auto-detect.
OPENAI_TRANSCRIBE_LANGUAGE=
# Only set this to point at an OpenAI-compatible gateway or proxy.
# Leave blank for api.openai.com.
OPENAI_BASE_URL=

# ── Automated Daily Backup ───────────────────────────────────
# Backup is FULLY AUTOMATED — no extra credentials needed.
# The backup container reads MONGO_URL, DB_NAME, and MASTER_ENCRYPTION_KEY
# from this file directly, connects to MongoDB Atlas, and uploads an
# AES-256-GCM encrypted dump to S3 daily at 2 AM UTC.
#
# One-time setup: configure S3 in the app UI after first deploy:
#   Settings → Cloud Backup → enter AWS credentials → Test + Save
